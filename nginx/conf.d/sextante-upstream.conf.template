upstream sextante {
    server ${SEXTANTE_HOST};
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

map $arg_request $sextante_no_cache {
    default         0;
    ~*GetFeatureInfo 1;
    ~*GetCapabilities 1;
    ~*DescribeFeatureType 1;
}

# Buckets separados: el plugin de QGIS se identifica con X-Mapalab-Client y cae
# solo en su zona; el visor y el resto caen solo en sextante_download. Una clave
# vacia desactiva la zona para esa peticion, asi ninguno le come cuota al otro.
map $http_x_mapalab_client $clave_sextante_visor {
    default "$binary_remote_addr$http_user_agent";
    ~.      '';
}

map $http_x_mapalab_client $clave_sextante_plugin {
    default '';
    ~.      $binary_remote_addr;
}

limit_req_zone $clave_sextante_visor  zone=sextante_download:10m rate=100r/s;
limit_req_zone $clave_sextante_plugin zone=mapalab_plugin:10m rate=10r/s;
