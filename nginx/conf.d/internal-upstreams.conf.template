upstream portal_backend {
    zone portal_backend 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    server ${PORTAL_HOST} resolve;
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

