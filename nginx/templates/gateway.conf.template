map "${SEO_ENABLED}" $seo_robots {
    "true"  "";
    default "noindex, nofollow";
}

map "${SEO_ENABLED}" $seo_block {
    "true"  0;
    default 1;
}

upstream portal {
    server ${PORTAL_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream mapalab {
    server ${MAPALAB_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream acervo {
    server ${ACERVO_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream acervo_console {
    server ${ACERVO_CONSOLE_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream mariachi {
    server ${MARIACHI_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream huachicol {
    server ${HUACHICOL_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

map $request_uri $acervo_content_disposition {
    default         "";
    ~*\.(txt|xlsx)$ "attachment";
}

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN} _;

    location = /ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /etc/nginx/version.json;
    }

    location = /geoserver/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        return 200 '{"slug":"geoserver","label":"GeoServer","version":"1.14.1"}';
    }

    location = /sieej/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /usr/share/nginx/html/sieej/ontoy.json;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN} _;

    ssl_certificate     ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 100M;
    ignore_invalid_headers off;

    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    include /etc/nginx/includes/security-headers.inc;
    include /etc/nginx/includes/gtm.inc;

    error_page 400 /error-pages/400.html;
    error_page 401 /error-pages/401.html;
    error_page 403 /error-pages/403.html;
    error_page 404 /error-pages/404.html;
    error_page 429 /error-pages/429.html;
    error_page 500 502 503 504 /error-pages/500.html;

    location /error-pages/ {
        alias /etc/nginx/error-pages/;
        internal;
    }

    location = /ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /etc/nginx/version.json;
    }

    location = /geoserver/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        return 200 '{"slug":"geoserver","label":"GeoServer","version":"1.14.1"}';
    }

    location = / {
        return 302 /mapalab/;
    }

    location / {
        limit_req zone=general burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://portal;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://portal;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
    }

    location /administrador/ {
        limit_req zone=general burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://portal;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
    }

    # Admin-only: mariachi los invoca via iieg-network directo al backend,
    # no deben ser alcanzables desde internet.
    location = /mapalab/api/layers/refresh-cache {
        return 403;
    }

    location = /mapalab/api/layers/invalidate-cache {
        return 403;
    }

    location ^~ /mapalab/assets/ {
        limit_req zone=static burst=200 nodelay;
        proxy_cache mapalab_assets;
        proxy_cache_valid 200 7d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status;
        add_header Cache-Control "public, max-age=31536000, immutable";
        proxy_pass http://mapalab/assets/;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /mapalab/api/download/ {
        limit_req zone=api burst=5 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://mapalab/api/download/;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    location ^~ /mapalab/ {
        limit_req zone=general burst=150 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://mapalab/;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        add_header X-Robots-Tag $seo_robots;
    }

    location ^~ /acervo/console/static/ {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://acervo_console/console/static/;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /acervo/console/ {
        limit_req zone=general burst=1000 nodelay;
        proxy_hide_header Content-Security-Policy;
        sub_filter "script-src 'self'" "script-src 'self' 'unsafe-inline' 'unsafe-eval'";
        sub_filter_once on;
        sub_filter_types text/html;
        proxy_pass http://acervo_console/console/;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ^~ /acervo/ {
        limit_req zone=api burst=100 nodelay;
        client_max_body_size 1G;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://acervo/;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
        add_header Content-Disposition $acervo_content_disposition always;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
        chunked_transfer_encoding off;
    }

    location ^~ /mariachi/ {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://mariachi;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    location = /sieej {
        return 301 /sieej/;
    }

    location = /sieej/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /usr/share/nginx/html/sieej/ontoy.json;
    }

    location ^~ /sieej/ {
        limit_req zone=static burst=200 nodelay;
        alias /usr/share/nginx/html/sieej/;
        try_files $uri $uri/ /sieej/index.html;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /huachicol/ {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://huachicol;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
    }

    include /etc/nginx/includes/geoserver-locations.inc;

    location = /robots.txt {
        if ($seo_block) {
            return 200 "User-agent: *\nDisallow: /\n";
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location = /sitemap.xml {
        if ($seo_block) {
            return 404;
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location ^~ /.well-known/ {
        root /usr/share/nginx/html;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }
}
