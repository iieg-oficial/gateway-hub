upstream portal {
    server ${PORTAL_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream mapalab {
    server ${MAPALAB_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream acervo {
    server ${ACERVO_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream acervo_console {
    server ${ACERVO_CONSOLE_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

upstream mariachi {
    server ${MARIACHI_HOST};
    keepalive 32;
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_name ${APP_DOMAIN};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 100M;
    ignore_invalid_headers off;

    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    include /etc/nginx/includes/security-headers.inc;

    error_page 400 /error-pages/400.html;
    error_page 401 /error-pages/401.html;
    error_page 403 /error-pages/403.html;
    error_page 404 /error-pages/404.html;
    error_page 500 502 503 504 /error-pages/500.html;

    location /error-pages/ {
        alias /etc/nginx/error-pages/;
        internal;
    }

    location = / {
        return 302 /mapalab/;
    }

    location / {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://portal;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://portal;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
    }

    location /administrador/ {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://portal;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    location ^~ /mapalab/ {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://mapalab/;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    location ^~ /acervo/console/static/ {
        include /etc/nginx/includes/vpn-access.inc;
        proxy_pass http://acervo_console/static/;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /acervo/console/ {
        include /etc/nginx/includes/vpn-access.inc;
        limit_req off;
        proxy_pass http://acervo_console/;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location ^~ /acervo/ {
        limit_req zone=api burst=100 nodelay;
        client_max_body_size 1G;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://acervo/;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
        chunked_transfer_encoding off;
    }

    location ^~ /mariachi/ {
        include /etc/nginx/includes/vpn-access.inc;
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://mariachi/;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    include /etc/nginx/includes/geoserver-locations.inc;

    location = /robots.txt {
        proxy_pass http://portal;
        include /etc/nginx/includes/proxy-params.inc;
        access_log off;
    }

    location = /sitemap.xml {
        proxy_pass http://portal;
        include /etc/nginx/includes/proxy-params.inc;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }
}
