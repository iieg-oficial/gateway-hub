map "${SEO_ENABLED}" $seo_robots {
    "true"  "";
    default "noindex, nofollow";
}

map "${SEO_ENABLED}" $seo_block {
    "true"  0;
    default 1;
}

map $host $gateway_domain {
    default "${APP_DOMAIN}";
}

map $upstream_http_content_type $acervo_tipo_inline {
    default 0;
    "~*^image/(png|jpe?g|gif|webp|avif)[ ]*(;|$)" 1;
    "~*^application/pdf[ ]*(;|$)" 1;
}

map "$acervo_tipo_inline:$upstream_http_content_disposition" $acervo_disposicion {
    default attachment;
    "~*^1:[ ]*attachment" attachment;
    "~^1:" inline;
}

map $upstream_http_content_disposition $acervo_disposicion_nombre {
    default "";
    "~*(;[ ]*filename.*)$" $1;
}

map $uri $gtm_head {
    "~^/(mariachi|sieej)(/|$)" "";
    default '<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src="https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);})(window,document,"script","dataLayer","${GTM_ID}");</script>';
}

map $uri $gtm_body {
    "~^/(mariachi|sieej)(/|$)" "";
    default '<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>';
}

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN} _;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /ontoy {
        include /etc/nginx/includes/allow-monitor.inc;
        deny all;
        set $gateway_ontoy_upstream "gateway-version-api:8088";
        proxy_pass http://$gateway_ontoy_upstream/ontoy;
    }

    location = /sextante/ontoy {
        include /etc/nginx/includes/allow-monitor.inc;
        deny all;
        set $sextante_ontoy_upstream "sextante-version-api:8088";
        proxy_pass http://$sextante_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /acervo/ontoy {
        include /etc/nginx/includes/allow-monitor.inc;
        deny all;
        set $acervo_ontoy_upstream "acervo-version-api:8088";
        proxy_pass http://$acervo_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /huachicol/ontoy {
        include /etc/nginx/includes/allow-monitor.inc;
        deny all;
        set $huachicol_ontoy_upstream "huachicol-version-api:8088";
        proxy_pass http://$huachicol_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /sieej/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /usr/share/nginx/html/sieej/ontoy.json;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN} _;

    ssl_certificate     ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/includes/ssl-stapling.inc;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 100M;

    limit_conn per_client ${CONN_LIMIT};

    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    include /etc/nginx/includes/security-headers.inc;
    include /etc/nginx/includes/gtm.inc;

    error_page 400 /error-pages/400.html;
    error_page 401 /error-pages/401.html;
    error_page 403 /error-pages/403.html;
    error_page 404 /error-pages/404.html;
    error_page 429 /error-pages/429.html;
    error_page 500 502 503 504 /error-pages/500.html;

    location /error-pages/ {
        alias /etc/nginx/error-pages/;
        internal;
    }

    location = /__mantenimiento/mapalab {
        internal;
        error_page 503 /error-pages/mantenimiento-mapalab.html;
        return 503;
    }

    location = /__mantenimiento/mapalab-widget {
        internal;
        types { }
        default_type "application/javascript; charset=utf-8";
        alias /etc/nginx/error-pages/mantenimiento-mapalab-widget.js;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
    }

    location = /error-pages/mantenimiento-mapalab.html {
        alias /etc/nginx/error-pages/mantenimiento-mapalab.html;
        internal;
        include /etc/nginx/includes/security-headers.inc;
        add_header Retry-After 60 always;
        add_header Cache-Control "no-store" always;
    }

    location = /ontoy {
        include /etc/nginx/includes/allow-monitor.inc;
        deny all;
        set $gateway_ontoy_upstream "gateway-version-api:8088";
        proxy_pass http://$gateway_ontoy_upstream/ontoy;
    }

    location = /sextante/ontoy {
        include /etc/nginx/includes/allow-monitor.inc;
        deny all;
        set $sextante_ontoy_upstream "sextante-version-api:8088";
        proxy_pass http://$sextante_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/includes/security-headers.inc;
    }

    location = /acervo/ontoy {
        include /etc/nginx/includes/allow-monitor.inc;
        deny all;
        set $acervo_ontoy_upstream "acervo-version-api:8088";
        proxy_pass http://$acervo_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/includes/security-headers.inc;
    }

    location = /huachicol/ontoy {
        include /etc/nginx/includes/allow-monitor.inc;
        deny all;
        set $huachicol_ontoy_upstream "huachicol-version-api:8088";
        proxy_pass http://$huachicol_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/includes/security-headers.inc;
    }

    location = / {
        limit_req zone=general burst=300;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
    }

    location / {
        limit_req zone=general burst=300;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
    }

    location ^~ /assets/ {
        limit_req zone=app_assets burst=1000;
        proxy_cache app_assets_cache;
        proxy_cache_key "$scheme$host$proxy_host$request_uri";
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status;
        add_header Cache-Control "public, max-age=31536000, immutable";
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /portal-admin {
        limit_req zone=general burst=300;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /api/sitio-admin {
        limit_req zone=api burst=200 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /api/sitio {
        limit_req zone=api burst=200 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /datos-abiertos {
        limit_req zone=general burst=300;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ^~ /base/ {
        limit_req zone=app_assets burst=1000;
        proxy_cache app_assets_cache;
        proxy_cache_key "$scheme$host$proxy_host$request_uri";
        proxy_cache_valid 200 1h;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /webassets/ {
        limit_req zone=app_assets burst=1000;
        proxy_cache app_assets_cache;
        proxy_cache_key "$scheme$host$proxy_host$request_uri";
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /api/administrador/acervo/thumb {
        limit_req zone=acervo_thumb burst=240 nodelay;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/administrador/acervo {
        limit_req zone=api burst=200 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/includes/security-headers.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/mariachi/acervo/thumb {
        limit_req zone=acervo_thumb burst=240 nodelay;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/mariachi/acervo {
        limit_req zone=api burst=200 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/includes/security-headers.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/internal/acervo/ {
        include /etc/nginx/includes/allow-internal-upload.inc;
        deny all;
        limit_req zone=api burst=200 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/includes/security-headers.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/mariachi/geoserver/files {
        limit_req zone=geoserver_files burst=400 nodelay;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location ^~ /api/administrador/geoserver/files {
        limit_req zone=geoserver_files burst=400 nodelay;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location /api/ {
        limit_req zone=api burst=200 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/includes/security-headers.inc;
    }

    location = /mapalab/api/layers/refresh-cache {
        return 403;
    }

    location = /mapalab/api/layers/invalidate-cache {
        return 403;
    }

    location = /mapalab/api/layers/tree/completo {
        return 403;
    }

    location = /mapalab/api/ontoy {
        return 403;
    }

    location = /mapalab/ontoy {
        return 403;
    }

    location ^~ /mapalab/assets/ {
        include /etc/nginx/includes/mantenimiento-mapalab.inc;
        limit_req zone=app_assets burst=1000;
        proxy_cache mapalab_assets;
        proxy_cache_key "$scheme$host$proxy_host$request_uri";
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status;
        add_header Cache-Control "public, max-age=31536000, immutable";
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /mapalab/api/download/ {
        include /etc/nginx/includes/mantenimiento-mapalab.inc;
        limit_req zone=api burst=10 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    location ^~ /mapalab/mcp {
        include /etc/nginx/includes/mantenimiento-mapalab.inc;
        limit_req zone=general burst=300;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
    }

    location ^~ /mapalab/api/privado/ {
        include /etc/nginx/includes/mantenimiento-mapalab.inc;
        limit_req zone=api burst=300 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_cache off;
        add_header X-Robots-Tag "noindex, nofollow" always;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /mapalab/api/ {
        include /etc/nginx/includes/mantenimiento-mapalab.inc;
        limit_req zone=api burst=300 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        add_header X-Robots-Tag $seo_robots;
        include /etc/nginx/includes/security-headers.inc;
    }

    location = /mapalab/embed {
        include /etc/nginx/includes/mantenimiento-mapalab.inc;
        limit_req zone=general burst=300;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        add_header X-Robots-Tag $seo_robots;
    }

    location ^~ /mapalab/widget/ {
        include /etc/nginx/includes/mantenimiento-mapalab-widget.inc;
        limit_req zone=general burst=300;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        add_header X-Robots-Tag $seo_robots;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /mapalab/ {
        include /etc/nginx/includes/mantenimiento-mapalab.inc;
        limit_req zone=general burst=300;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        add_header X-Robots-Tag $seo_robots;
        include /etc/nginx/includes/security-headers.inc;
    }

    location = /aviso-de-privacidad.pdf {
        limit_req zone=static burst=500;
        set $acervo_upstream "${ACERVO_HOST}";
        rewrite ^ /iieg/avisos-de-privacidad.pdf break;
        proxy_pass http://$acervo_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
        proxy_hide_header Content-Disposition;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        add_header Content-Disposition 'inline; filename="Aviso_de_Privacidad_Integral_IIEG.pdf"' always;
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /acervo/thumb/ {
        limit_req zone=acervo_thumb burst=240 nodelay;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ^~ /acervo/ {
        limit_except GET OPTIONS {
            deny all;
        }

        limit_req zone=acervo_files burst=600 nodelay;
        proxy_buffering off;
        set $acervo_upstream "${ACERVO_HOST}";
        rewrite ^/acervo/(.*) /$1 break;
        proxy_pass http://$acervo_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
        proxy_hide_header Content-Disposition;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        add_header Content-Disposition "$acervo_disposicion$acervo_disposicion_nombre" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        include /etc/nginx/includes/security-headers.inc;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
        chunked_transfer_encoding off;
    }

    location ^~ /mariachi/assets/ {
        limit_req zone=app_assets burst=1000;
        proxy_cache app_assets_cache;
        proxy_cache_key "$scheme$host$proxy_host$request_uri";
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status;
        set $mariachi_upstream "${MARIACHI_HOST}";
        proxy_pass http://$mariachi_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/includes/security-headers.inc;
    }

    location ^~ /mariachi/ {
        limit_req zone=general burst=300;
        set $mariachi_upstream "${MARIACHI_HOST}";
        proxy_pass http://$mariachi_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    location ^~ /colibri/ {
        limit_req zone=static burst=500;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location = /sieej {
        return 301 /sieej/;
    }

    location = /sieej/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /usr/share/nginx/html/sieej/ontoy.json;
    }

    location ^~ /sieej/assets/ {
        limit_req zone=app_assets burst=1000;
        alias /usr/share/nginx/html/sieej/assets/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/includes/security-headers.inc;

        location ~ /\. {
            deny all;
        }
    }

    location ^~ /sieej/ {
        limit_req zone=static burst=500;
        alias /usr/share/nginx/html/sieej/;
        try_files $uri $uri/ /sieej/index.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/includes/security-headers.inc;

        location ~ /\. {
            deny all;
        }
    }

    include /etc/nginx/includes/sextante-locations.inc;
    include /etc/nginx/includes/sextante-compat-geoserver.inc;

    location = /robots.txt {
        if ($seo_block) {
            return 200 "User-agent: *\nDisallow: /\n";
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location = /sitemap.xml {
        if ($seo_block) {
            return 404;
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location ^~ /.well-known/ {
        root /usr/share/nginx/html;
        access_log off;

        location ~ ^/\.well-known/.*/\. {
            deny all;
        }
    }

    location ~ /\. {
        deny all;
    }
}
