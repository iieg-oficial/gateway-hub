map "${SEO_ENABLED}" $seo_robots {
    "true"  "";
    default "noindex, nofollow";
}

map "${SEO_ENABLED}" $seo_block {
    "true"  0;
    default 1;
}

map $request_uri $acervo_content_disposition {
    default         "";
    ~*\.(txt|xlsx)$ "attachment";
}

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN} _;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /ontoy {
        set $gateway_ontoy_upstream "gateway-version-api:8088";
        proxy_pass http://$gateway_ontoy_upstream/ontoy;
    }

    location = /sextante/ontoy {
        set $sextante_ontoy_upstream "sextante-version-api:8088";
        proxy_pass http://$sextante_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /acervo/ontoy {
        set $acervo_ontoy_upstream "acervo-version-api:8088";
        proxy_pass http://$acervo_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /huachicol/ontoy {
        set $huachicol_ontoy_upstream "huachicol-version-api:8088";
        proxy_pass http://$huachicol_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /sieej/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /usr/share/nginx/html/sieej/ontoy.json;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN} _;

    ssl_certificate     ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/includes/ssl-stapling.inc;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 100M;
    ignore_invalid_headers off;

    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    include /etc/nginx/includes/security-headers.inc;
    include /etc/nginx/includes/gtm.inc;

    error_page 400 /error-pages/400.html;
    error_page 401 /error-pages/401.html;
    error_page 403 /error-pages/403.html;
    error_page 404 /error-pages/404.html;
    error_page 429 /error-pages/429.html;
    error_page 500 502 503 504 /error-pages/500.html;

    location /error-pages/ {
        alias /etc/nginx/error-pages/;
        internal;
    }

    location = /ontoy {
        set $gateway_ontoy_upstream "gateway-version-api:8088";
        proxy_pass http://$gateway_ontoy_upstream/ontoy;
    }

    location = /sextante/ontoy {
        set $sextante_ontoy_upstream "sextante-version-api:8088";
        proxy_pass http://$sextante_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /acervo/ontoy {
        set $acervo_ontoy_upstream "acervo-version-api:8088";
        proxy_pass http://$acervo_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /huachicol/ontoy {
        set $huachicol_ontoy_upstream "huachicol-version-api:8088";
        proxy_pass http://$huachicol_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # La raiz la sirve sitio2026 (Portalito). Sin bot-protection: es la ruta del
    # healthcheck y la puerta de entrada de los crawlers legitimos.
    location = / {
        limit_req zone=general burst=150 nodelay;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
    }

    location / {
        limit_req zone=general burst=150 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
    }

    location ^~ /assets/ {
        limit_req zone=static burst=200 nodelay;
        add_header Cache-Control "public, max-age=31536000, immutable";
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /portal-admin {
        limit_req zone=general burst=150 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /api/sitio-admin {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ^~ /api/sitio {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
    }

    # CKAN. Sin bot-protection a proposito: su API es consumo programatico y el
    # include rechaza curl, wget, python-requests y demas clientes sin navegador.
    location ^~ /datos-abiertos {
        limit_req zone=general burst=150 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ^~ /base/ {
        limit_req zone=static burst=200 nodelay;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /webassets/ {
        limit_req zone=static burst=200 nodelay;
        proxy_pass http://sitio_backend;
        include /etc/nginx/includes/sitio-hide-headers.inc;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /api/administrador/acervo/thumb {
        # Miniaturas del Acervo: muchas peticiones GET por pagina pero cacheables.
        # Zona/burst propios para no chocar con el limite general del API y, sobre
        # todo, NO forzar no-store: se deja pasar el Cache-Control inmutable del
        # thumbnail para que el navegador cachee y no repita la rafaga en cada render.
        limit_req zone=acervo_thumb burst=120 nodelay;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/administrador/acervo {
        limit_req zone=api burst=20 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/mariachi/acervo/thumb {
        limit_req zone=acervo_thumb burst=120 nodelay;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/mariachi/acervo {
        limit_req zone=api burst=20 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Subida interna al Acervo desde plataformas externas (Portal). La autentica
    # mariachi-api con X-Internal-Token; sin bot-protection porque el cliente es
    # server-to-server, y con settings de upload. Debe ir antes del catch-all /api/.
    location ^~ /api/internal/acervo/ {
        limit_req zone=api burst=20 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/mariachi/geoserver/files {
        limit_req zone=geoserver_files burst=200 nodelay;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location ^~ /api/administrador/geoserver/files {
        limit_req zone=geoserver_files burst=200 nodelay;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
    }

    # Admin-only: mariachi los invoca via iieg-network directo al backend,
    # no deben ser alcanzables desde internet.
    location = /mapalab/api/layers/refresh-cache {
        return 403;
    }

    location = /mapalab/api/layers/invalidate-cache {
        return 403;
    }

    # Las dos rutas del /ontoy de mapalab se cierran aqui, antes del rewrite:
    # el de abajo convierte /mapalab/<x> en /<x>, asi que un deny puesto en el
    # nginx de mapalab nunca ve el prefijo. /mapalab/api/ontoy es el handler del
    # backend y /mapalab/ontoy el sidecar version-api, que desde mapalab 1.102.0
    # publica los mismos checks fusionados. huachicol no se ve afectado: sondea
    # el puerto del nginx de mapalab directo, sin pasar por el gateway.
    location = /mapalab/api/ontoy {
        return 403;
    }

    location = /mapalab/ontoy {
        return 403;
    }

    location ^~ /mapalab/assets/ {
        limit_req zone=static burst=200 nodelay;
        proxy_cache mapalab_assets;
        proxy_cache_valid 200 7d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status;
        add_header Cache-Control "public, max-age=31536000, immutable";
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /mapalab/api/download/ {
        limit_req zone=api burst=5 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    location ^~ /mapalab/mcp {
        limit_req zone=general burst=20 nodelay;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
    }

    # La API va aparte del catch-all de abajo por una razon concreta: aquel lleva
    # proxy_intercept_errors on, pensado para que los 404 del SPA caigan en la
    # pagina de error del gateway. Aplicado a /mapalab/api/ convierte el JSON de
    # error de FastAPI en HTML, y cualquier cliente que haga res.json() sobre la
    # respuesta de error recibe una pagina. Aqui se deja pasar el cuerpo original.
    # Tampoco se vacia Accept-Encoding: el backend comprime y el gateway solo
    # reenvia, en vez de recibir 221 KB en crudo para volver a comprimirlos.
    location ^~ /mapalab/api/ {
        limit_req zone=api burst=60 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        add_header X-Robots-Tag $seo_robots;
    }

    location ^~ /mapalab/ {
        limit_req zone=general burst=150 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://mapalab_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        add_header X-Robots-Tag $seo_robots;
    }

    # /aviso-de-privacidad y /aviso-de-privacidad-simplificado los sirve sitio2026
    # desde su CMS, no este archivo: los avisos se editan en el portal en vez de
    # reemplazar un PDF en acervo. Como el match exacto gana siempre sobre el
    # location / de sitio2026, las rutas tienen que no existir aqui para que el
    # portal las reciba. Ver sitio2026#60.

    location = /aviso-de-privacidad.pdf {
        # El integral en PDF conserva ruta propia: es la version imprimible que
        # enlaza la pagina del CMS. La URL no lleva version ni ubicacion del
        # objeto, asi que publicar uno nuevo es reemplazarlo en el bucket, sin
        # tocar ningun repo ni desplegar.
        limit_req zone=static burst=200 nodelay;
        set $acervo_upstream "${ACERVO_HOST}";
        rewrite ^ /iieg/avisos-de-privacidad.pdf break;
        proxy_pass http://$acervo_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
        proxy_hide_header Content-Disposition;
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        add_header Content-Disposition 'inline; filename="Aviso_de_Privacidad_Integral_IIEG.pdf"' always;
    }

    location ^~ /acervo/thumb/ {
        # Miniaturas publicas on-the-fly del Acervo: las sirve mariachi-api (WebP
        # escalado), no SeaweedFS. Prefijo mas largo que /acervo/ => gana el matcheo
        # ^~ y NO se reescribe el path (mariachi-api espera /acervo/thumb/...).
        # Solo responde para buckets publicos; privados devuelven 404.
        limit_req zone=acervo_thumb burst=120 nodelay;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ^~ /acervo/ {
        limit_req zone=static burst=200 nodelay;
        client_max_body_size 1G;
        proxy_buffering off;
        proxy_request_buffering off;
        set $acervo_upstream "${ACERVO_HOST}";
        rewrite ^/acervo/(.*) /$1 break;
        proxy_pass http://$acervo_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
        add_header Content-Disposition $acervo_content_disposition always;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
        chunked_transfer_encoding off;
    }

    location ^~ /mariachi/assets/ {
        limit_req zone=static burst=200 nodelay;
        set $mariachi_upstream "${MARIACHI_HOST}";
        proxy_pass http://$mariachi_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /mariachi/ {
        limit_req zone=general burst=20 nodelay;
        set $mariachi_upstream "${MARIACHI_HOST}";
        proxy_pass http://$mariachi_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    location ^~ /colibri/ {
        limit_req zone=static burst=200 nodelay;
        proxy_pass http://portal_backend;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location = /sieej {
        return 301 /sieej/;
    }

    location = /sieej/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /usr/share/nginx/html/sieej/ontoy.json;
    }

    location ^~ /sieej/assets/ {
        limit_req zone=static burst=200 nodelay;
        alias /usr/share/nginx/html/sieej/assets/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /sieej/ {
        limit_req zone=static burst=200 nodelay;
        alias /usr/share/nginx/html/sieej/;
        try_files $uri $uri/ /sieej/index.html;
        add_header Cache-Control "no-store" always;
    }

    include /etc/nginx/includes/sextante-locations.inc;
    include /etc/nginx/includes/sextante-compat-geoserver.inc;

    location = /robots.txt {
        if ($seo_block) {
            return 200 "User-agent: *\nDisallow: /\n";
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location = /sitemap.xml {
        if ($seo_block) {
            return 404;
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location ^~ /.well-known/ {
        root /usr/share/nginx/html;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }
}
