map "${SEO_ENABLED}" $seo_robots {
    "true"  "";
    default "noindex, nofollow";
}

map "${SEO_ENABLED}" $seo_block {
    "true"  0;
    default 1;
}

map $request_uri $acervo_content_disposition {
    default         "";
    ~*\.(txt|xlsx)$ "attachment";
}

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN} _;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /etc/nginx/version.json;
    }

    location = /geoserver/ontoy {
        set $geoserver_ontoy_upstream "geoserver-version-api:8088";
        proxy_pass http://$geoserver_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /acervo/ontoy {
        set $acervo_ontoy_upstream "acervo-version-api:8088";
        proxy_pass http://$acervo_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /huachicol/ontoy {
        set $huachicol_ontoy_upstream "huachicol-version-api:8088";
        proxy_pass http://$huachicol_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /sieej/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /usr/share/nginx/html/sieej/ontoy.json;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN} _;

    ssl_certificate     ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 100M;
    ignore_invalid_headers off;

    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    include /etc/nginx/includes/security-headers.inc;
    include /etc/nginx/includes/gtm.inc;

    error_page 400 /error-pages/400.html;
    error_page 401 /error-pages/401.html;
    error_page 403 /error-pages/403.html;
    error_page 404 /error-pages/404.html;
    error_page 429 /error-pages/429.html;
    error_page 500 502 503 504 /error-pages/500.html;

    location /error-pages/ {
        alias /etc/nginx/error-pages/;
        internal;
    }

    location = /ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /etc/nginx/version.json;
    }

    location = /geoserver/ontoy {
        set $geoserver_ontoy_upstream "geoserver-version-api:8088";
        proxy_pass http://$geoserver_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /acervo/ontoy {
        set $acervo_ontoy_upstream "acervo-version-api:8088";
        proxy_pass http://$acervo_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = /huachicol/ontoy {
        set $huachicol_ontoy_upstream "huachicol-version-api:8088";
        proxy_pass http://$huachicol_ontoy_upstream/ontoy;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location = / {
        return 302 /mapalab/;
    }

    location / {
        limit_req zone=general burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
    }

    location ^~ /api/administrador/acervo {
        limit_req zone=api burst=20 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
    }

    location /administrador/ {
        limit_req zone=general burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
    }

    # Admin-only: mariachi los invoca via iieg-network directo al backend,
    # no deben ser alcanzables desde internet.
    location = /mapalab/api/layers/refresh-cache {
        return 403;
    }

    location = /mapalab/api/layers/invalidate-cache {
        return 403;
    }

    location ^~ /mapalab/assets/ {
        limit_req zone=static burst=200 nodelay;
        proxy_cache mapalab_assets;
        proxy_cache_valid 200 7d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status;
        add_header Cache-Control "public, max-age=31536000, immutable";
        set $mapalab_upstream "${MAPALAB_HOST}";
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://$mapalab_upstream;
        include /etc/nginx/includes/proxy-params.inc;
    }

    location ^~ /mapalab/api/download/ {
        limit_req zone=api burst=5 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        set $mapalab_upstream "${MAPALAB_HOST}";
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://$mapalab_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    location ^~ /mapalab/mcp {
        limit_req zone=general burst=20 nodelay;
        set $mapalab_upstream "${MAPALAB_HOST}";
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://$mapalab_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
    }

    location ^~ /mapalab/ {
        limit_req zone=general burst=150 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        set $mapalab_upstream "${MAPALAB_HOST}";
        rewrite ^/mapalab/(.*) /$1 break;
        proxy_pass http://$mapalab_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        add_header X-Robots-Tag $seo_robots;
    }

    location ^~ /acervo/ {
        limit_req zone=static burst=200 nodelay;
        client_max_body_size 1G;
        proxy_buffering off;
        proxy_request_buffering off;
        set $acervo_upstream "${ACERVO_HOST}";
        rewrite ^/acervo/(.*) /$1 break;
        proxy_pass http://$acervo_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
        add_header Content-Disposition $acervo_content_disposition always;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
        chunked_transfer_encoding off;
    }

    location ^~ /mariachi/ {
        limit_req zone=general burst=20 nodelay;
        set $mariachi_upstream "${MARIACHI_HOST}";
        proxy_pass http://$mariachi_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    location = /sieej {
        return 301 /sieej/;
    }

    location = /sieej/ontoy {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        alias /usr/share/nginx/html/sieej/ontoy.json;
    }

    location ^~ /sieej/ {
        limit_req zone=static burst=200 nodelay;
        alias /usr/share/nginx/html/sieej/;
        try_files $uri $uri/ /sieej/index.html;
        add_header Cache-Control "no-cache" always;
    }

    location ^~ /huachicol/public/ {
        set $huachicol_upstream "${HUACHICOL_HOST}";
        proxy_pass http://$huachicol_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    location ^~ /huachicol/ {
        limit_req zone=huachicol burst=200 nodelay;
        set $huachicol_upstream "${HUACHICOL_HOST}";
        proxy_pass http://$huachicol_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    include /etc/nginx/includes/geoserver-locations.inc;

    location = /robots.txt {
        if ($seo_block) {
            return 200 "User-agent: *\nDisallow: /\n";
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location = /sitemap.xml {
        if ($seo_block) {
            return 404;
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location ^~ /.well-known/ {
        root /usr/share/nginx/html;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }
}
