worker_processes auto;
worker_rlimit_nofile 16384;

error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    large_client_header_buffers 8 64k;

    set_real_ip_from ${REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time urt=$upstream_response_time';

    log_format json_logs escape=json
        '{'
            '"time":"$time_iso8601",'
            '"remote_addr":"$remote_addr",'
            '"request_method":"$request_method",'
            '"request_uri":"$request_uri",'
            '"status":$status,'
            '"body_bytes_sent":$body_bytes_sent,'
            '"http_referer":"$http_referer",'
            '"http_user_agent":"$http_user_agent",'
            '"request_time":$request_time,'
            '"upstream_response_time":"$upstream_response_time",'
            '"upstream_addr":"$upstream_addr",'
            '"upstream_cache_status":"$upstream_cache_status"'
        '}';

    access_log /dev/stdout json_logs;
    error_log  /dev/stderr warn;

    sendfile    on;
    tcp_nopush  on;
    tcp_nodelay on;

    keepalive_timeout 65;

    open_file_cache          max=1000 inactive=20s;
    open_file_cache_valid    30s;
    open_file_cache_min_uses 2;
    open_file_cache_errors   off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/csv text/javascript application/javascript application/json application/xml image/svg+xml text/xml;

    proxy_buffering        on;
    proxy_buffer_size      32k;
    proxy_buffers          16 32k;
    proxy_busy_buffers_size 64k;

    proxy_cache_path /var/cache/nginx-data/sextante
        levels=1:2
        keys_zone=sextante_cache:320m
        max_size=50g
        inactive=30d
        use_temp_path=off;

    limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=static:10m rate=50r/s;
    limit_req_zone $binary_remote_addr zone=acervo_thumb:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=geoserver_files:10m rate=30r/s;
    limit_req_status 429;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Allowlist explicita. El plugin de MapaLab habla por QgsNetworkAccessManager
    # y su UA es "Mozilla/5.0 QGIS/<version>/<so>"; hasta ahora pasaba solo porque
    # no coincidia con ninguna lista. Declararlo aqui evita que un patron nuevo
    # lo tumbe sin que nadie relacione las dos cosas.
    map $http_user_agent $ua_en_allowlist {
        default 0;
        ~*QGIS/ 1;
    }

    map $http_user_agent $ua_sospechoso {
        default 0;
        ''      1;
        ~*(scrapy|httpclient|spider|java|perl|ruby|php|go-http|node-fetch|axios|postman|insomnia|httpie|headless|phantom|selenium|puppeteer|playwright|mechanize|libwww|lwp|urllib|winhttp|httrack|clshttp|archiver|loader|email|harvest|extract|grab|miner|nikto|scan|attack|inject|exploit) 1;
        ~*(ChatGPT|GPTBot|Google-Extended|anthropic|ClaudeBot|CCBot|Bytespider|PetalBot|SemrushBot|AhrefsBot|MJ12bot|DotBot|Barkrowler|DataForSeoBot|BLEXBot|YandexBot) 1;
        ~*(^curl|^wget|python-requests|python-urllib|aiohttp) 1;
    }

    map $ua_en_allowlist$ua_sospechoso $ua_bloqueado {
        default 0;
        '01'    1;
    }

    # Sextante mantiene su propia lista, mas amplia que la general (bloquea
    # "python" y "bot" genericos). Se conserva tal cual y solo se le antepone
    # la misma allowlist.
    map $http_user_agent $ua_sospechoso_sextante {
        default 0;
        ''      1;
        ~*(curl|wget|python|scrapy|httpclient|bot|spider|java|perl|ruby|php|go-http|node-fetch|axios|postman|insomnia|httpie|headless|phantom|selenium|puppeteer|playwright|ChatGPT|Google-Extended|anthropic) 1;
    }

    map $ua_en_allowlist$ua_sospechoso_sextante $ua_bloqueado_sextante {
        default 0;
        '01'    1;
    }

    proxy_cache_path /var/cache/nginx-data/mapalab_assets
        keys_zone=mapalab_assets:5m
        max_size=500m
        inactive=7d
        use_temp_path=off;

    include /etc/nginx/conf.d/*.conf;
}
