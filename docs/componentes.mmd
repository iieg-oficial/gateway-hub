graph TB
    %% --- Actores externos ---
    U_PUB([Publico General])
    U_ADMIN([Administradores VPN])
    GITHUB{{GitHub: CI/CD & Versionado}}
    DISCORD{{Discord Webhook}}

    %% =========================================================
    %% S1: Gateway + Acervo + Huachicol (1 VM)
    %% =========================================================
    subgraph S_CORE["S1: Gateway + Acervo + Huachicol"]
        direction TB

        subgraph GATEWAY["gateway-hub 1.25.0"]
            direction TB
            GW["gateway-hub-nginx-1<br/>nginx 1.28.2"]
            GW_EXP["nginx-exporter<br/>(stub_status)"]
            GW_ONTOY[/"/etc/nginx/version.json<br/>(GET /ontoy)"/]
            GW --> GW_ONTOY
        end

        subgraph ACERVO["acervo 1.23.0"]
            direction TB
            ACE_SW["acervo-seaweedfs<br/>SeaweedFS 4.23 (S3 :8333)"]
            ACE_VA["acervo-version-api<br/>python:alpine :8088"]
            subgraph ACE_BKT["Buckets"]
                direction LR
                B_PT[("portal")]
                B_ML[("mapalab")]
                B_SJ[("sieej")]
                B_MR[("mariachi")]
                B_IG[("iieg")]
                B_DE[("dataengine")]
            end
            ACE_SW --> ACE_BKT
        end

        subgraph HUACHICOL["huachicol 1.20.0"]
            direction TB
            HU_PROM["prometheus"]
            HU_GRAF["grafana"]
            HU_LOKI["loki + alertmanager"]
            HU_AGENT["alloy + cadvisor + node-exporter"]
            HU_VA["huachicol-version-api<br/>python:alpine :8088"]
        end
    end

    %% =========================================================
    %% S2: MapaLab (VM dedicada)
    %% =========================================================
    subgraph S_MAPALAB["S2: mapalab 1.28.5"]
        direction TB
        ML_FE["mapalab-frontend<br/>nginx + dist/"]
        ML_BE["mapalab-backend<br/>FastAPI uvicorn :8000"]
        ML_ONTOY[/"/ontoy ← app/__version__.py"/]
        ML_BE --> ML_ONTOY
    end

    %% =========================================================
    %% S3: GeoServer
    %% =========================================================
    subgraph S_GEO["S3: geoserver 1.21.0"]
        direction TB
        GS["geoserver<br/>kartoza/geoserver 2.27.0 :8080"]
        GS_VA["geoserver-version-api<br/>python:alpine :8088"]
    end

    %% =========================================================
    %% S4: DataEngine
    %% =========================================================
    subgraph S_DATA["S4: dataengine 1.14.3"]
        direction TB
        DE_PG[("dataengine-primary<br/>PostgreSQL 18 + PostGIS 3.6 :5432")]
        DE_PGB["dataengine-pgbouncer :6432"]
        DE_BK["dataengine-backup<br/>(dump semanal a Acervo)"]
        DE_JOBS["dataengine-jobs<br/>cron + ontoy_server.py :8088"]
        DE_PGB --> DE_PG
        DE_BK -.->|pg_dump| DE_PG
        DE_JOBS --> DE_PG
    end

    %% =========================================================
    %% MARIACHI (VM dedicada)
    %% =========================================================
    subgraph S_MARIACHI["MARIACHI 1.1.0 (VM dedicada)"]
        direction TB
        MARI_NGINX["mariachi-nginx"]
        MARI_API["mariachi-api<br/>FastAPI :8000"]
        MARI_ADMIN["mariachi-admin<br/>React + Ant Design"]
        MARI_REDIS[("redis")]
        MARI_ONTOY[/"pyproject.toml<br/>(self probe via get_app_version)"/]
        MARI_NGINX --> MARI_API
        MARI_NGINX --> MARI_ADMIN
        MARI_API --> MARI_REDIS
        MARI_API --> MARI_ONTOY
    end

    %% =========================================================
    %% SIEEJ (sin container; estatico servido por gateway)
    %% =========================================================
    subgraph S_SIEEJ["sieej 1.12.1 (dist estatico)"]
        SJ_DIST[/"sieej/frontend/dist/<br/>(bind mount en gateway)"/]
    end

    %% =========================================================
    %% CONEXIONES
    %% =========================================================

    %% --- Trafico publico ---
    U_PUB --> GW
    U_ADMIN -.->|VPN| HU_GRAF
    U_ADMIN -.->|VPN| GS
    U_ADMIN -.->|VPN| MARI_NGINX

    %% --- Gateway routing ---
    GW --> MARI_NGINX
    GW --> ML_FE
    GW --> GS
    GW --> HU_GRAF
    GW --> ACE_SW
    GW --> SJ_DIST

    %% --- Gateway /ontoy proxy_pass (desde gateway-hub 1.25.0) ---
    GW ==>|/geoserver/ontoy| GS_VA
    GW ==>|/acervo/ontoy| ACE_VA
    GW ==>|/huachicol/ontoy| HU_VA
    GW -->|/sieej/ontoy| SJ_DIST

    %% --- mariachi consume /ontoy de todos ---
    MARI_API -.->|GET /ontoy| GW_ONTOY
    MARI_API -.->|GET /ontoy| GS_VA
    MARI_API -.->|GET /ontoy| ACE_VA
    MARI_API -.->|GET /ontoy| HU_VA
    MARI_API -.->|GET /ontoy| DE_JOBS
    MARI_API -.->|GET /ontoy| ML_BE
    MARI_API -.->|GET /ontoy| SJ_DIST

    %% --- DB compartida ---
    MARI_API -->|iieg_portal| DE_PGB
    ML_BE -->|sslmode=require| DE_PGB
    GS -->|datastore PostGIS| DE_PG

    %% --- Almacenamiento S3 ---
    MARI_API ==>|Archivos| B_PT
    ML_BE ==>|Metadatos| B_ML
    DE_BK ==>|Respaldos| B_DE

    %% --- Observabilidad ---
    HU_PROM -.->|scrape| GW_EXP
    HU_AGENT -.->|Docker socket| S_CORE
    HU_LOKI -.->|Alertas| DISCORD

    %% --- CI/CD ---
    GITHUB ==>|Auto deploy| MARI_API
    GITHUB ==>|Auto deploy| ML_BE

    %% =========================================================
    %% ESTILOS (alineados con arquitectura.mmd)
    %% =========================================================
    style GITHUB fill:#24292e,color:#fff,stroke:#fafafa
    style DISCORD fill:#5865F2,color:#fff,stroke:#404EED
    style U_PUB fill:#334155,color:#fff
    style U_ADMIN fill:#064e3b,color:#fff,stroke:#10b981

    style S_CORE fill:#ffffff,stroke:#475569
    style GATEWAY fill:#f8fafc,stroke:#1e293b
    style ACERVO fill:#f1f5f9,stroke:#0ea5e9,stroke-dasharray: 5 5
    style HUACHICOL fill:#fef2f2,stroke:#dc2626
    style ACE_BKT fill:#ffffff,stroke:#0ea5e9,stroke-dasharray: 3 3

    style S_MAPALAB fill:#f0fdf4,stroke:#16a34a
    style S_GEO fill:#fff7ed,stroke:#ea580c
    style S_DATA fill:#fef2f2,stroke:#dc2626
    style S_MARIACHI fill:#fffbeb,stroke:#d97706
    style S_SIEEJ fill:#eff6ff,stroke:#2563eb,stroke-dasharray: 5 5

    %% Nodos oscuros (servicios core)
    style GW fill:#1e293b,color:#fff
    style HU_GRAF fill:#7f1d1d,color:#fff
    style DE_PG fill:#991b1b,color:#fff
    style ML_BE fill:#14532d,color:#fff
    style MARI_NGINX fill:#7f1d1d,color:#fff
    style MARI_API fill:#7f1d1d,color:#fff
    style MARI_REDIS fill:#0f172a,color:#fff
    style GS fill:#7c2d12,color:#fff
    style ACE_SW fill:#0c4a6e,color:#fff

    %% Sidecars version-api (resaltados)
    style ACE_VA fill:#0ea5e9,color:#fff,stroke:#0c4a6e,stroke-width:2px
    style HU_VA fill:#0ea5e9,color:#fff,stroke:#0c4a6e,stroke-width:2px
    style GS_VA fill:#0ea5e9,color:#fff,stroke:#0c4a6e,stroke-width:2px
    style DE_JOBS fill:#991b1b,color:#fff,stroke:#0ea5e9,stroke-width:2px

    %% Endpoints /ontoy (nodos de tipo flag)
    style GW_ONTOY fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
    style ML_ONTOY fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
    style MARI_ONTOY fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
    style SJ_DIST fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a

    %% Buckets
    style B_PT fill:#0f172a,color:#fff
    style B_ML fill:#0f172a,color:#fff
    style B_SJ fill:#0f172a,color:#fff
    style B_MR fill:#0f172a,color:#fff
    style B_IG fill:#0f172a,color:#fff
    style B_DE fill:#0f172a,color:#fff
