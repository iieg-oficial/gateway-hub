GATEWAY_BIND_ADDR=<ip-de-bind-del-gateway, 0.0.0.0 para el edge>
APP_DOMAIN=<dominio publico del gateway>
GTM_ID=<ID de Google Tag Manager>

# Origenes que se suman a img-src y media-src de la CSP, separados por espacios.
# Vacia en produccion: ahi el acervo se sirve desde el propio dominio y ya entra
# por 'self'. Solo la llenan los entornos que se sirven con otro host (espejo, dev).
CSP_EXTRA_ORIGINS=<origenes extra para img-src y media-src, vacio en produccion>

SSL_CERTIFICATE=<ruta al certificado SSL dentro del contenedor>
SSL_CERTIFICATE_KEY=<ruta a la llave privada SSL dentro del contenedor>
SSL_HOST_PATH=<ruta del host con el certificado y la llave>

# Cadena de CA (intermedia + raiz) que verifica la respuesta OCSP. Sin ella el
# stapling queda desactivado y el arranque lo anuncia en el log. Vacia en local.
SSL_TRUSTED_CERTIFICATE=<ruta a la cadena de CA dentro del contenedor>

SIEEJ_DIST_PATH=<ruta del host al dist compilado de sieej>

# Cache de nginx (tiles de sextante y assets de mapalab). Vive en el host para
# que sobreviva a los rebuild: dentro del contenedor se perdia en cada deploy.
# Necesita ~50 GB libres en ese filesystem.
NGINX_CACHE_PATH=<ruta del host donde persiste el cache de nginx>

PORTAL_HOST=<ip:puerto del servicio Portal (mariachi, por historia)>
SITIO_HOST=<ip:puerto del nginx de sitio2026 (Portalito)>
MAPALAB_HOST=<ip:puerto del servicio MapaLab>
ACERVO_HOST=<ip:puerto del servicio Acervo API>
MARIACHI_HOST=<ip:puerto del servicio MARIACHI>
SEXTANTE_HOST=<ip:puerto del servicio GeoServer>

# CIDR confiable para set_real_ip_from (X-Forwarded-For). En GCP el FortiGate
# emite XFF desde el CIDR confiable (FortiGate estatal). En local no aplica (no entra trafico via XFF).
REAL_IP_FROM=<CIDR>

SEO_ENABLED=<true|false>
ONTOY_DISK_PATH=<ruta-del-filesystem-que-se-mide>
# ZIP del complemento de QGIS que vigila ONTOY_DEPENDENCIES. Va directo al Acervo
# y no por el gateway: el objeto es lo que se cae —ya paso, con el ZIP de nombre
# estable sin subir— y asi el check no depende del TLS ni del DNS publico desde
# dentro de la red. Admite ${ACERVO_HOST} para no repetir el host.
PLUGIN_QGIS_URL=<url interna del zip, p.ej. http://${ACERVO_HOST}/<ruta-del-objeto>>
