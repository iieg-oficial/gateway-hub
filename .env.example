APP_DOMAIN=<dominio publico del gateway>

SSL_CERTIFICATE=<ruta al certificado SSL dentro del contenedor>
SSL_CERTIFICATE_KEY=<ruta a la llave privada SSL dentro del contenedor>
SSL_VOLUME_PATH=<ruta_host:ruta_contenedor:ro>

PORTAL_HOST=<ip:puerto del servicio Portal>
MAPALAB_HOST=<ip:puerto del servicio MapaLab>
ACERVO_HOST=<ip:puerto del servicio Acervo API>
ACERVO_CONSOLE_HOST=<ip:puerto del servicio Acervo Console>
MARIACHI_HOST=<ip:puerto del servicio MARIACHI>
GEOSERVER_HOST=<ip:puerto del servicio GeoServer>

VPN_ALLOWED_IPS=<CIDRs separados por coma>
